{
  "mode": "service",
  "start": "go run -ldflags=-linkmode=internal ./cmd/server -config=configs/config.yaml -disable-worker",
  "workdir": ".",
  "env": {
    "CGO_ENABLED": "0",
    "INFRA_HTTP_ADDR": ":18080",
    "INFRA_GRPC_ADDR": ":19090",
    "INFRA_DATABASE_URL": "postgres://infra:infra@127.0.0.1:55433/infra_controlplane?sslmode=disable",
    "INFRA_REDIS_ADDR": "127.0.0.1:56380",
    "INFRA_LOG_LEVEL": "error"
  },
  "ready_url": "http://127.0.0.1:18080/healthz",
  "ready_status": [200],
  "startup_timeout": 30
}
